generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum Role {
  SHIPPER
  TRUCKER
}

enum LoadStatus {
  PENDING
  BOOKED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum JourneyStatus {
  AVAILABLE
  MATCHED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  ARCHIVED
}

enum ProposedBy {
  SHIPPER
  TRUCKER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  phone        String?
  totalCapacity Float?
  truckType    String?
  averageRating Float?  @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  loads           Load[]    @relation("ShipperLoads")
  carrierLoads    Load[]    @relation("CarrierLoads")
  journeys        Journey[] @relation("TruckerJourneys")
  ratingsReceived Rating[]  @relation("TruckerRatings")
  ratingsGiven    Rating[]  @relation("ShipperRatings")

  @@index([role])
}

model Load {
  id        String @id @default(cuid())
  shipper   User   @relation("ShipperLoads", fields: [shipperId], references: [id], onDelete: Cascade)
  shipperId String

  originCity  String
  originState String
  destCity    String
  destState   String

  // Geospatial points for radius / intersection queries.
  // Nullable so existing rows aren't broken by this migration;
  // backfill or require them going forward at the application layer.
  originPoint Unsupported("geometry(Point, 4326)")?
  destPoint   Unsupported("geometry(Point, 4326)")?

  originLat   Float?
  originLng   Float?
  destLat     Float?
  destLng     Float?

  vehicleType String?
  priceInr    Float?
  weightTons  Float?
  truckType   String?

  carrierId   String?
  carrier     User?  @relation("CarrierLoads", fields: [carrierId], references: [id])

  cargoType String
  weightKg  Float
  budget    Decimal @db.Decimal(10, 2)

  pickupDate       DateTime
  deliveryDeadline DateTime

  description String?
  status      LoadStatus @default(PENDING)

  matches Match[]
  ratings Rating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([originCity, originState])
  @@index([destCity, destState])
  @@index([status])
  @@index([originPoint], type: Gist)
  @@index([destPoint], type: Gist)
}

model Journey {
  id        String @id @default(cuid())
  trucker   User   @relation("TruckerJourneys", fields: [truckerId], references: [id], onDelete: Cascade)
  truckerId String

  originCity  String
  originState String
  destCity    String
  destState   String

  dropPoints  String[] @default([])

  originPoint Unsupported("geometry(Point, 4326)")?
  destPoint   Unsupported("geometry(Point, 4326)")?

  originLat   Float?
  originLng   Float?
  destLat     Float?
  destLng     Float?

  vehicleType String?
  priceInr    Float?
  price       Float?  @default(0)
  weightTons  Float?

  departureDate       DateTime
  availableCapacityKg Float
  truckType           String
  askingPricePerKg    Decimal @db.Decimal(10, 2)

  status JourneyStatus @default(AVAILABLE)

  matches Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([originCity, originState])
  @@index([destCity, destState])
  @@index([status])
  @@index([originPoint], type: Gist)
  @@index([destPoint], type: Gist)
}

model Match {
  id        String  @id @default(cuid())
  load      Load    @relation(fields: [loadId], references: [id], onDelete: Cascade)
  loadId    String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  journeyId String

  status      MatchStatus @default(PENDING)
  proposedBy  ProposedBy
  agreedPrice Decimal?    @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([loadId, journeyId])
  @@index([status])
}

model Rating {
  id        String   @id @default(cuid())
  score     Int      // 1 to 5
  review    String?
  shipper   User     @relation("ShipperRatings", fields: [shipperId], references: [id], onDelete: Cascade)
  shipperId String
  trucker   User     @relation("TruckerRatings", fields: [truckerId], references: [id], onDelete: Cascade)
  truckerId String
  load      Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  loadId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([loadId, shipperId])
  @@index([truckerId])
  @@index([shipperId])
}

